<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      A platform theme is enough because all real styling happens in Compose
      (see core/designsystem). This only needs to give the window a sensible
      background before the first frame, which is why it matches the dark surface
      rather than flashing white.
    -->
    <style name="Theme.Reelforge" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
